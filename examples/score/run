#!/bin/sh
# The score slide: how long is each of eight recordings, in minutes?
#   ./run                 answer from recording/, with no key and no network
#   ./run threshold 0.5   the same answers. A level whose probability is under the bar reads null, as not sure.
#   ./run live            ask the server THINKTHEN_BASE_URL names. thinkthen reads the key itself.
# score takes no bar of its own, so jq applies it here, the way a program would.
set -eu
cd "$(dirname -- "$0")"
usage() { echo "usage: ./run [live] [threshold T]" >&2; exit 2; }
from='--replay recording' bar=0
while [ $# -gt 0 ]; do
  case $1 in
    live) from=--no-cache ;;
    threshold) [ $# -ge 2 ] || usage; case $2 in ''|*[!0-9.]*) usage ;; esac; bar=$2; shift ;;
    *) usage ;;
  esac
  shift
done
answers=$(printf '%s\n' 'Her Majesty' Yesterday "Octopus's Garden" Something 'Come Together' 'A Day in the Life' 'Hey Jude' 'Revolution 9' |
  thinkthen score 'The text is the title of a song by the Beatles. How long is the recording?' \
    'about 0 minutes' 'about 1 minute' 'about 2 minutes' 'about 3 minutes' 'about 4 minutes' \
    'about 5 minutes' 'about 6 minutes' 'about 7 minutes' 'about 8 minutes' 'about 9 minutes' \
    --lines --details $from)
printf '%s\n' "$answers" | jq -c --argjson bar "$bar" '.answer.probabilities[.answer.level] as $p
  | {song: .input, minutes: .value, level: (if $p >= $bar then .answer.level else null end), p: $p}'
